{
  "name": "oaxakita",
  "private": true,
  "scripts": {
    "build:js": "esbuild src/main.jsx --bundle --minify --format=esm --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=assets/app.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/app.css --minify",
    "build": "npm run build:js && npm run build:css"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16"
  }
}
